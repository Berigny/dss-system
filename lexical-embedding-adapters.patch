@@ -0,0 +1,107 @@
+"""Deterministic offline lexical embeddings shared by all adapters.
+
+This module extracts the exact bag-of-words embedding approach used by
+``FaissAdapter`` (tokenize, build a corpus vocabulary, L2-normalized term
+frequency vectors) so that every adapter can run with the SAME deterministic
+embedding when the opt-in lexical mode is selected (``--embedding lexical``
+on ``harness/runner.py``).  It requires no network access and no third-party
+dependencies.
+
+The lexical mode measures structural / retrieval-integrity behavior of each
+vector store; it is NOT a measure of neural embedding quality.
+"""
+import math
+import re
+from typing import Any, Dict, List
+
+
+_STOPWORDS = frozenset({
+    "the", "a", "an", "is", "are", "was", "were", "be", "been", "being",
+    "have", "has", "had", "do", "does", "did", "will", "would", "could",
+    "should", "may", "might", "must", "shall", "can", "need", "dare",
+    "ought", "used", "to", "of", "in", "for", "on", "with", "at", "by",
+    "from", "as", "into", "through", "during", "before", "after", "above",
+    "below", "between", "under", "again", "further", "then", "once", "here",
+    "there", "when", "where", "why", "how", "all", "each", "few", "more",
+    "most", "other", "some", "such", "no", "nor", "not", "only", "own",
+    "same", "so", "than", "too", "very", "just", "and", "but", "if", "or",
+    "because", "until", "while", "what", "which", "who", "whom", "this",
+    "that", "these", "those", "am", "it", "its", "their", "them", "they",
+    "we", "you", "he", "she", "his", "her", "our", "us", "me", "my",
+})
+
+
+def _tokenize(text: str) -> List[str]:
+    tokens = re.findall(r"[a-zA-Z0-9]+", text.lower())
+    return [t for t in tokens if t not in _STOPWORDS]
+
+
+def _build_vocab(texts: List[str]) -> Dict[str, int]:
+    vocab: Dict[str, int] = {}
+    for text in texts:
+        for token in _tokenize(text):
+            if token not in vocab:
+                vocab[token] = len(vocab)
+    return vocab
+
+
+def _vectorize(text: str, vocab: Dict[str, int], dim: int) -> List[float]:
+    vec = [0.0] * dim
+    for token in _tokenize(text):
+        idx = vocab.get(token)
+        if idx is not None:
+            vec[idx] += 1.0
+    norm = math.sqrt(sum(v * v for v in vec)) or 1.0
+    return [v / norm for v in vec]
+
+
+def _normalize(vec: List[float]) -> List[float]:
+    norm = math.sqrt(sum(v * v for v in vec)) or 1.0
+    return [v / norm for v in vec]
+
+
+def _cosine(a: List[float], b: List[float]) -> float:
+    return sum(x * y for x, y in zip(a, b))
+
+
+class LexicalEmbeddingFunction:
+    """Callable embedding function backed by the shared lexical vectors.
+
+    The vocabulary is built deterministically from the FIRST batch of texts
+    encoded (the corpus documents) and frozen thereafter, so queries are
+    embedded in the same space — mirroring how ``FaissAdapter`` builds its
+    vocabulary from the corpus before embedding the query.
+    """
+
+    def __init__(self) -> None:
+        self._vocab: Dict[str, int] | None = None
+
+    @property
+    def dim(self) -> int | None:
+        return None if self._vocab is None else max(len(self._vocab), 1)
+
+    def encode(self, texts: List[str]) -> List[List[float]]:
+        if self._vocab is None:
+            self._vocab = _build_vocab(texts)
+        dim = max(len(self._vocab), 1)
+        return [_vectorize(text, self._vocab, dim) for text in texts]
+
+    # Chroma embedding-function protocol.
+    def __call__(self, input: List[str]) -> List[List[float]]:  # noqa: A002
+        return self.encode(list(input))
+
+    def embed_documents(self, input: List[str]) -> List[List[float]]:  # noqa: A002
+        return self.encode(list(input))
+
+    def embed_query(self, input: List[str]) -> List[List[float]]:  # noqa: A002
+        return self.encode(list(input))
+
+    def name(self) -> str:
+        return "dss-lexical"
+
+    def get_config(self) -> Dict[str, Any]:
+        return {}
+
+    @staticmethod
+    def build_from_config(config: Dict[str, Any]) -> "LexicalEmbeddingFunction":
+        return LexicalEmbeddingFunction()
